{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable", "WebWorker"],
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "types": ["bun"],
    "paths": { "@pdfvault/engine": ["./packages/engine/src/index.ts"] }
  },
  "include": ["packages/*/src", "packages/*/test", "packages/*/*.ts", "scripts", "e2e", "playwright.config.ts"],
  "exclude": ["packages/*/dist", "packages/engine/wasm"]
}
