{
  "name": "pdfvault-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build:wasm": "bun scripts/build-wasm.ts",
    "fetch-models": "bun scripts/fetch-models.ts",
    "fixtures": "cargo run -q -p pdfvault-fixtures -- fixtures/generated",
    "build:web": "bun packages/web/build.ts",
    "build:cli": "bun packages/cli/build.ts",
    "dev": "bun packages/web/build.ts --serve",
    "check:network": "bun scripts/check-no-network.ts packages/web/dist",
    "typecheck": "tsc --noEmit -p .",
    "lint": "oxlint --deny-warnings packages scripts e2e",
    "test": "bun test packages scripts",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/bun": "1.4.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "oxlint": "1.87.0",
    "typescript": "7.0.2"
  }
}
